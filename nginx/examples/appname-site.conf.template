# Example configuration for a protected site running on the host (outside Docker).
# Copy this template to `nginx/templates/<appname>-site.conf.template` and edit the `<appname>` and `<App port>` placeholders.
# The `<appname>` prefix is hardcoded; the domain is injected at container startup from the shared `AUTH_COOKIE_DOMAIN` env var.

server {
    listen 80;
    server_name <appname>${AUTH_COOKIE_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name <appname>${AUTH_COOKIE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/auth.conf;

    location / {
        auth_request /internal/auth-verify;
        error_page 401 = /internal/login-redirect;

        auth_request_set $auth_user $upstream_http_x_user;
        add_header X-User $auth_user always;
        add_header Cache-Control "no-store" always;

        proxy_pass http://host.docker.internal:<App port>;
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
